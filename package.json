    "marketplace:check": "bun scripts/generate-marketplace.mjs --check"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@xyflow/react": "^12.12.0",
