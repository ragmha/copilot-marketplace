  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.12.0"
  },
  "scripts": {
    "preinstall": "node scripts/only-bun.mjs",
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
