---
import PluginAnatomy from "./PluginAnatomy";

const legend = [
  { label: "Required", tone: "accent" },
  { label: "Common capability", tone: "default" },
  { label: "Optional extras", tone: "muted" },
];
---

<figure id="anatomy" class="mx-auto w-full max-w-6xl scroll-mt-16 px-6 pb-8">
  <div
    class="overflow-hidden rounded-lg border border-border bg-background"
    role="img"
    aria-label="Diagram: a marketplace catalog points to a Copilot-style plugin package containing a plugin.json manifest and client-specific skills, agents, commands, MCP configuration, hooks, LSP configuration, and scripts. Components load into supported Copilot clients; exact filenames and support vary by client. This example is not the portable Agent Plugins format."
  >
    <PluginAnatomy client:visible />
  </div>

  <figcaption class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-[11px] text-muted-foreground">
    {
      legend.map((entry) => (
        <span class="flex items-center gap-2">
          <span
            class:list={[
              "size-2.5 rounded-sm border",
              entry.tone === "accent" && "border-primary/40 bg-primary/20",
              entry.tone === "default" && "border-border bg-card",
              entry.tone === "muted" && "border-dashed border-border bg-background",
            ]}
            aria-hidden="true"
          />
          {entry.label}
        </span>
      ))
    }
    <span class="ml-auto">Copilot-style example; support and file layouts vary by client</span>
  </figcaption>
</figure>
