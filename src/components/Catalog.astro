---
import { pluginTypes, type Plugin } from "../lib/marketplace";
import PluginCard from "./PluginCard.astro";

interface Props {
  plugins: Plugin[];
}

const { plugins } = Astro.props;

const tabs = pluginTypes.map((entry) => ({
  ...entry,
  count: plugins.filter((plugin) => plugin.type === entry.type).length,
}));

// Newest first, so the default view matches the default sort.
const sorted = [...plugins].sort((a, b) => b.updated.localeCompare(a.updated));
---

<section id="catalog" class="mx-auto w-full max-w-5xl scroll-mt-16 px-6 pb-20">
  <div id="tabs" role="group" aria-label="Filter by type" class="flex flex-wrap gap-2">
    {
      tabs.map((tab) => (
        <button
          type="button"
          data-type={tab.type}
          disabled={tab.count === 0}
          aria-pressed={tab.type === "plugin" ? "true" : "false"}
          class="flex items-center gap-2 rounded-full border border-border px-3 py-1.5 text-xs transition-colors hover:bg-accent disabled:pointer-events-none disabled:opacity-40 aria-pressed:border-foreground aria-pressed:bg-foreground aria-pressed:text-background"
        >
          {tab.label}
          <span class="text-muted-foreground aria-pressed:text-background">{tab.count}</span>
        </button>
      ))
    }
  </div>

  <div class="mt-6 flex flex-wrap items-end gap-4">
    <label class="flex min-w-0 flex-1 items-center gap-2 border-b border-border pb-2">
      <span class="sr-only">Search the directory</span>
      <span class="text-muted-foreground" aria-hidden="true">/</span>
      <input
        id="search"
        type="search"
        placeholder="search names, descriptions, authors, and versions"
        autocomplete="off"
        class="w-full bg-transparent text-sm text-foreground outline-none placeholder:text-muted-foreground"
      />
    </label>

    <label class="flex items-center gap-2 border-b border-border pb-2 text-xs">
      <span class="text-muted-foreground">Sort</span>
      <select
        id="sort"
        class="bg-transparent text-foreground outline-none [&>option]:bg-background"
      >
        <option value="recent">Recently updated</option>
        <option value="name">Name A–Z</option>
      </select>
    </label>
  </div>

  <p id="result-count" class="mt-4 text-xs text-muted-foreground"></p>

  <div id="plugin-grid" class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {sorted.map((plugin) => <PluginCard plugin={plugin} />)}
  </div>

  <p
    id="empty-state"
    hidden
    class="mt-4 rounded-lg border border-dashed border-border p-10 text-center text-xs text-muted-foreground"
  >
    Nothing matches that search.
  </p>
</section>

<script>
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("#plugin-grid .plugin-card"),
  );
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>("#tabs [data-type]"),
  );
  const search = document.getElementById("search") as HTMLInputElement | null;
  const sort = document.getElementById("sort") as HTMLSelectElement | null;
  const count = document.getElementById("result-count");
  const empty = document.getElementById("empty-state");

  let type = "plugin";
  let query = "";

  // Sorting reorders with CSS `order` so the grid never has to re-render.
  const applySort = () => {
    const mode = sort?.value ?? "recent";
    const ranked = [...cards].sort((a, b) =>
      mode === "name"
        ? (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "")
        : (b.dataset.updated ?? "").localeCompare(a.dataset.updated ?? ""),
    );
    ranked.forEach((card, index) => {
      card.style.order = String(index);
    });
  };

  const render = () => {
    let visible = 0;

    for (const card of cards) {
      const show =
        card.dataset.type === type && (card.dataset.search ?? "").includes(query);
      card.hidden = !show;
      if (show) visible += 1;
    }

    if (count) {
      count.textContent = `${visible} ${visible === 1 ? "result" : "results"}`;
    }
    if (empty) empty.hidden = visible !== 0;
  };

  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      type = tab.dataset.type ?? "plugin";
      for (const other of tabs) {
        other.setAttribute("aria-pressed", String(other.dataset.type === type));
      }
      render();
    });
  }

  search?.addEventListener("input", () => {
    query = search.value.trim().toLowerCase();
    render();
  });

  sort?.addEventListener("change", applySort);

  applySort();
  render();
</script>
