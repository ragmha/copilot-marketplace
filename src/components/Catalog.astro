---
import type { Plugin } from "../lib/marketplace";
import PluginCard from "./PluginCard.astro";

interface Props {
  plugins: Plugin[];
}

const { plugins } = Astro.props;
const categories = ["All", ...new Set(plugins.map((plugin) => plugin.category))];
---

<section id="catalog" class="mx-auto w-full max-w-5xl scroll-mt-16 px-6 pb-20">
  <div class="flex flex-wrap items-center gap-3">
    <label class="flex min-w-0 flex-1 items-center gap-2 border-b border-border pb-2">
      <span class="sr-only">Search plugins</span>
      <span class="text-muted-foreground" aria-hidden="true">/</span>
      <input
        id="search"
        type="search"
        placeholder="search plugins"
        autocomplete="off"
        class="w-full bg-transparent text-sm text-foreground outline-none placeholder:text-muted-foreground"
      />
    </label>
    <span id="result-count" class="shrink-0 pb-2 text-xs text-muted-foreground"></span>
  </div>

  <div
    id="filters"
    role="group"
    aria-label="Filter by category"
    class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-xs"
  >
    {
      categories.map((category) => (
        <button
          type="button"
          data-category={category}
          aria-pressed={category === "All" ? "true" : "false"}
          class="text-muted-foreground underline-offset-4 transition-colors hover:text-foreground aria-pressed:text-foreground aria-pressed:underline"
        >
          {category.toLowerCase()}
        </button>
      ))
    }
  </div>

  <div id="plugin-grid" class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {plugins.map((plugin) => <PluginCard plugin={plugin} />)}
  </div>

  <p
    id="empty-state"
    hidden
    class="mt-6 rounded-lg border border-dashed border-border p-10 text-center text-xs text-muted-foreground"
  >
    No plugins match that search.
  </p>
</section>

<script>
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("#plugin-grid .plugin-card"),
  );
  const filters = Array.from(
    document.querySelectorAll<HTMLButtonElement>("#filters [data-category]"),
  );
  const search = document.getElementById("search") as HTMLInputElement | null;
  const count = document.getElementById("result-count");
  const empty = document.getElementById("empty-state");

  let category = "All";
  let query = "";

  const render = () => {
    let visible = 0;

    for (const card of cards) {
      const matchesCategory =
        category === "All" || card.dataset.category === category;
      const matchesQuery = (card.dataset.search ?? "").includes(query);
      const show = matchesCategory && matchesQuery;
      card.hidden = !show;
      if (show) visible += 1;
    }

    if (count) {
      count.textContent = `${visible} ${visible === 1 ? "plugin" : "plugins"}`;
    }
    if (empty) empty.hidden = visible !== 0;
  };

  for (const filter of filters) {
    filter.addEventListener("click", () => {
      category = filter.dataset.category ?? "All";
      for (const other of filters) {
        other.setAttribute(
          "aria-pressed",
          String(other.dataset.category === category),
        );
      }
      render();
    });
  }

  search?.addEventListener("input", () => {
    query = search.value.trim().toLowerCase();
    render();
  });

  render();
</script>
