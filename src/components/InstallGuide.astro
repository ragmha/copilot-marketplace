---
import { installGuidesFor } from "../lib/marketplace";

interface Props {
  plugin: string;
}

const { plugin } = Astro.props;
const installGuides = installGuidesFor(plugin);
---

<section id="install" class="scroll-mt-20">
  <h2 class="text-sm font-bold tracking-tight">Install {plugin}</h2>
  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
    Pick your client and copy the command.
  </p>

  <div class="mt-5 rounded-lg border border-border bg-card p-5">
    <label for="install-client" class="text-[11px] text-muted-foreground">Client</label>

    <div class="relative mt-1.5">
      <select
        id="install-client"
        class="w-full appearance-none rounded-md border border-border bg-background py-2 pr-9 pl-3 text-sm transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
      >
        {installGuides.map((guide) => <option value={guide.id}>{guide.label}</option>)}
      </select>

      <svg
        class="pointer-events-none absolute top-1/2 right-3 size-3.5 -translate-y-1/2 text-muted-foreground"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>

    {
      installGuides.map((guide, index) => (
        <div data-panel={guide.id} hidden={index !== 0}>
          {guide.primary ? (
            <>
              <p class="mt-4 text-[11px] text-muted-foreground">{guide.primary.label}</p>

              <button
                type="button"
                data-copy-code
                class="group mt-1.5 flex w-full items-start gap-3 rounded-md border border-border bg-background px-3 py-2.5 text-left transition-colors hover:bg-accent"
              >
                <code class="min-w-0 flex-1 overflow-x-auto text-xs whitespace-pre">
                  {guide.primary.code}
                </code>
                <span class="shrink-0 text-[11px] text-muted-foreground transition-colors group-hover:text-foreground">
                  copy
                </span>
              </button>
            </>
          ) : (
            <p class="mt-4 text-xs leading-relaxed text-muted-foreground">{guide.summary}</p>
          )}

          <details class="group mt-4 border-t border-border pt-4">
            <summary class="flex cursor-pointer list-none items-center gap-1.5 text-xs text-muted-foreground transition-colors hover:text-foreground">
              <svg
                class="size-3 transition-transform group-open:rotate-90"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="m6 4 4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Full setup for {guide.label}
            </summary>

            <ol class="mt-4 space-y-4">
              {guide.steps.map((step, stepIndex) => (
                <li class="grid grid-cols-[1.5rem_1fr] gap-x-3">
                  <span class="text-xs text-muted-foreground tabular-nums" aria-hidden="true">
                    {String(stepIndex + 1).padStart(2, "0")}
                  </span>

                  <div class="min-w-0">
                    <p class="text-sm leading-relaxed">{step.text}</p>

                    {step.code && (
                      <button
                        type="button"
                        data-copy-code
                        class="group/code mt-2 flex w-full items-start gap-3 rounded-md border border-border bg-background px-3 py-2.5 text-left transition-colors hover:bg-accent"
                      >
                        <code class="min-w-0 flex-1 overflow-x-auto text-xs whitespace-pre">
                          {step.code}
                        </code>
                        <span class="shrink-0 text-[11px] text-muted-foreground transition-colors group-hover/code:text-foreground">
                          copy
                        </span>
                      </button>
                    )}

                    {step.caption && (
                      <p class="mt-2 text-[11px] leading-relaxed text-muted-foreground">
                        {step.caption}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </details>
        </div>
      ))
    }

    <p
      id="install-copy-status"
      role="status"
      aria-live="polite"
      class="mt-3 min-h-4 text-xs text-primary"
    >
    </p>
  </div>
</section>

<script>
  const select = document.querySelector<HTMLSelectElement>("#install-client");
  const panels = Array.from(document.querySelectorAll<HTMLElement>("#install [data-panel]"));
  const status = document.getElementById("install-copy-status");

  select?.addEventListener("change", () => {
    for (const panel of panels) {
      panel.hidden = panel.dataset.panel !== select.value;
    }
    if (status) status.textContent = "";
  });

  // The command lives in the markup, so there is only one copy of each string.
  for (const button of document.querySelectorAll<HTMLElement>("#install [data-copy-code]")) {
    button.addEventListener("click", async () => {
      const text = button.querySelector("code")?.textContent?.trim();
      if (!text || !status) return;
      try {
        await navigator.clipboard.writeText(text);
        status.textContent = "Copied.";
      } catch {
        status.textContent = "Copy failed. Select the text and copy it manually.";
      }
    });
  }
</script>
