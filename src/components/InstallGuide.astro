---
import { installGuides } from "../lib/marketplace";
---

<section id="install" class="mx-auto w-full max-w-5xl scroll-mt-16 px-6 pb-20">
  <h2 class="text-xl font-bold tracking-tight">Installation</h2>
  <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted-foreground">
    Register the marketplace once per client. After that, installing a plugin is a single
    command or a single click.
  </p>

  <div
    id="install-tabs"
    role="tablist"
    aria-label="Choose a Copilot client"
    class="mt-6 flex flex-wrap gap-2"
  >
    {
      installGuides.map((guide, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${guide.id}`}
          data-guide={guide.id}
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`panel-${guide.id}`}
          class="rounded-full border border-border px-3 py-1.5 text-xs transition-colors hover:bg-accent aria-selected:border-foreground aria-selected:bg-foreground aria-selected:text-background"
        >
          {guide.label}
        </button>
      ))
    }
  </div>

  {
    installGuides.map((guide, index) => (
      <div
        id={`panel-${guide.id}`}
        role="tabpanel"
        aria-labelledby={`tab-${guide.id}`}
        data-panel={guide.id}
        hidden={index !== 0}
        class="mt-6 rounded-lg border border-border bg-card p-6"
      >
        <p class="text-sm text-muted-foreground">{guide.summary}</p>

        <ol class="mt-5 space-y-5">
          {guide.steps.map((step, stepIndex) => (
            <li class="grid grid-cols-[1.5rem_1fr] gap-x-3">
              <span class="text-xs text-muted-foreground tabular-nums" aria-hidden="true">
                {String(stepIndex + 1).padStart(2, "0")}
              </span>

              <div class="min-w-0">
                <p class="text-sm leading-relaxed">{step.text}</p>

                {step.code && (
                  <button
                    type="button"
                    data-copy-code
                    class="group mt-2 flex w-full items-start gap-3 rounded-md border border-border bg-background px-3 py-2.5 text-left transition-colors hover:bg-accent"
                  >
                    <code class="min-w-0 flex-1 overflow-x-auto text-xs whitespace-pre">
                      {step.code}
                    </code>
                    <span class="shrink-0 text-[11px] text-muted-foreground transition-colors group-hover:text-foreground">
                      copy
                    </span>
                  </button>
                )}

                {step.caption && (
                  <p class="mt-2 text-[11px] leading-relaxed text-muted-foreground">
                    {step.caption}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    ))
  }

  <p
    id="install-copy-status"
    role="status"
    aria-live="polite"
    class="mt-3 min-h-4 text-xs text-primary"
  >
  </p>
</section>

<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>("#install-tabs [data-guide]"),
  );
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-panel]"));
  const status = document.getElementById("install-copy-status");

  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      const id = tab.dataset.guide;
      for (const other of tabs) {
        other.setAttribute("aria-selected", String(other.dataset.guide === id));
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.panel !== id;
      }
    });
  }

  // The command lives in the markup, so there is only one copy of each string.
  for (const button of document.querySelectorAll<HTMLElement>("[data-copy-code]")) {
    button.addEventListener("click", async () => {
      const text = button.querySelector("code")?.textContent?.trim();
      if (!text || !status) return;
      try {
        await navigator.clipboard.writeText(text);
        status.textContent = "Copied.";
      } catch {
        status.textContent = "Copy failed. Select the text and copy it manually.";
      }
    });
  }
</script>
