---
import { branding, marketplaceRepo, pluginGuideHref } from "../lib/marketplace";
---

<footer class="mt-auto border-t border-border">
  <div
    class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-3 px-6 py-8 text-xs text-muted-foreground"
  >
    <span>{branding.organization} &middot; {branding.title}</span>
    <div class="flex flex-wrap gap-x-5 gap-y-3">
      <a href={pluginGuideHref} class="hover:text-foreground">What is a plugin?</a>
      <a href={`https://github.com/${marketplaceRepo}`} class="hover:text-foreground">Built on GitHub Copilot plugins</a>
    </div>
  </div>
</footer>
