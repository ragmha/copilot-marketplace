---
import { appSettings, cliCommand, cloudSettings } from "../lib/marketplace";

const actions = [
  { href: "#catalog", label: "Browse the catalog", trailing: "→" },
  { href: "#learning", label: "Learning hub", leading: "◇" },
  { href: "#contribute", label: "Contribute", leading: "+" },
];
---

<section id="top" class="mx-auto w-full max-w-6xl px-6 pt-20 pb-24">
  <p class="text-xs font-bold tracking-[0.14em] text-primary uppercase">
    Internal Copilot plugin marketplace
  </p>

  <h1
    class="mt-4 max-w-5xl text-4xl leading-[1.08] font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl"
  >
    Install ready-made workflows for releases, code review, onboarding, and more
    <span class="text-muted-foreground">—</span> or browse what your colleagues have
    built and build on it.
  </h1>

  <div class="mt-10 grid max-w-3xl gap-4 sm:grid-cols-3">
    {
      actions.map((action) => (
        <a
          href={action.href}
          class="flex min-h-16 items-center justify-between gap-3 rounded-xl border border-border bg-card px-6 text-base font-semibold text-card-foreground shadow-xs transition-all hover:-translate-y-0.5 hover:shadow-lg"
        >
          <span class="flex items-center gap-2.5">
            {action.leading && (
              <span class="text-xl font-normal text-muted-foreground" aria-hidden="true">
                {action.leading}
              </span>
            )}
            {action.label}
          </span>
          {action.trailing && (
            <span class="text-xl font-normal" aria-hidden="true">
              {action.trailing}
            </span>
          )}
        </a>
      ))
    }
  </div>

  <div id="install" class="relative mt-4 max-w-xl scroll-mt-24">
    <div
      class="flex min-h-16 items-stretch overflow-hidden rounded-xl bg-primary text-primary-foreground shadow-lg"
    >
      <button
        type="button"
        data-copy="app"
        class="flex flex-1 items-center gap-3 px-6 text-left text-base font-semibold transition-colors hover:bg-primary/90"
      >
        <span class="text-xl font-normal" aria-hidden="true">+</span>
        Add marketplace to GitHub Copilot app
      </button>
      <button
        id="install-toggle"
        type="button"
        aria-label="Show installation options"
        aria-expanded="false"
        aria-controls="install-menu"
        class="border-l border-primary-foreground/25 px-5 text-lg transition-colors hover:bg-primary/90"
        >⌄</button
      >
    </div>

    <div
      id="install-menu"
      hidden
      class="absolute inset-x-0 top-[4.5rem] z-20 rounded-xl border border-border bg-popover p-1.5 text-popover-foreground shadow-lg"
    >
      <button
        type="button"
        data-copy="app"
        class="block w-full rounded-md px-4 py-2.5 text-left text-sm transition-colors hover:bg-accent hover:text-accent-foreground"
        >Copy Copilot app marketplace settings</button
      >
      <button
        type="button"
        data-copy="cloud"
        class="block w-full rounded-md px-4 py-2.5 text-left text-sm transition-colors hover:bg-accent hover:text-accent-foreground"
        >Copy cloud agent settings</button
      >
    </div>

    <button
      type="button"
      data-copy="cli"
      class="mt-3 flex min-h-16 w-full items-center justify-between gap-3 rounded-xl border border-border bg-card px-6 text-left text-base text-card-foreground shadow-xs transition-all hover:-translate-y-0.5 hover:shadow-lg"
    >
      Copy Copilot CLI command
      <span class="text-lg text-muted-foreground" aria-hidden="true">⧉</span>
    </button>

    <p
      id="copy-status"
      role="status"
      aria-live="polite"
      class="mt-2 min-h-5 px-1 text-xs text-primary"
    >
    </p>
  </div>
</section>

<script
  is:inline
  define:vars={{ snippets: { app: appSettings, cloud: cloudSettings, cli: cliCommand } }}
>
  const labels = {
    app: "GitHub Copilot app settings",
    cloud: "Cloud agent settings",
    cli: "Copilot CLI command",
  };
  const status = document.getElementById("copy-status");
  const menu = document.getElementById("install-menu");
  const toggle = document.getElementById("install-toggle");

  const closeMenu = () => {
    if (!menu || !toggle) return;
    menu.hidden = true;
    toggle.setAttribute("aria-expanded", "false");
  };

  toggle?.addEventListener("click", (event) => {
    event.stopPropagation();
    if (!menu) return;
    menu.hidden = !menu.hidden;
    toggle.setAttribute("aria-expanded", String(!menu.hidden));
  });

  document.addEventListener("click", (event) => {
    if (menu && !menu.hidden && !menu.contains(event.target)) closeMenu();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });

  document.querySelectorAll("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const key = button.getAttribute("data-copy");
      const text = snippets[key];
      if (!status || !text) return;
      try {
        await navigator.clipboard.writeText(text);
        status.textContent = `${labels[key]} copied to your clipboard.`;
      } catch {
        status.textContent = `Copy failed. Use this value manually: ${text}`;
      }
      closeMenu();
    });
  });
</script>
