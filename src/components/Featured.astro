---
import FeaturedCard from "./FeaturedCard.astro";
import type { Plugin } from "../lib/marketplace";

interface Props {
  plugins: Plugin[];
}

const { plugins } = Astro.props;

const picks = plugins
  .filter((plugin) => plugin.featured)
  .sort((a, b) => b.updated.localeCompare(a.updated))
  .slice(0, 3);
---

{
  picks.length > 0 && (
    <section id="picks" class="mx-auto w-full max-w-5xl scroll-mt-16 px-6 pb-16">
      <h2 class="text-xl font-bold tracking-tight">Editor's picks</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        Standout ways to customize Copilot, chosen by the platform team.
      </p>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {picks.map((plugin) => (
          <FeaturedCard plugin={plugin} />
        ))}
      </div>
    </section>
  )
}
