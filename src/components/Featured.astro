---
import type { Plugin } from "../lib/marketplace";
import PluginCard from "./PluginCard.astro";

interface Props {
  plugins: Plugin[];
}

const { plugins } = Astro.props;
---

<section class="mx-auto w-full max-w-6xl border-t border-border px-6 py-20">
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div>
      <p class="text-xs font-bold tracking-[0.14em] text-primary uppercase">
        Handpicked for your next piece of work
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        Featured now
      </h2>
    </div>
    <a
      href="#catalog"
      class="text-sm font-semibold text-primary transition-opacity hover:opacity-80"
      >View all plugins →</a
    >
  </div>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {plugins.map((plugin, index) => <PluginCard plugin={plugin} index={index} />)}
  </div>
</section>
