---
import type { Plugin } from "../lib/marketplace";

interface Props {
  plugin: Plugin;
  index: number;
}

const { plugin, index } = Astro.props;

const tints = [
  "bg-chart-1/15 text-chart-1",
  "bg-chart-2/15 text-chart-2",
  "bg-chart-4/15 text-chart-4",
];
const tint = tints[index % tints.length];
---

<article
  class="plugin-card group flex flex-col rounded-xl border border-border bg-card p-6 text-card-foreground shadow-xs transition-all hover:-translate-y-0.5 hover:shadow-lg"
  data-name={plugin.name}
  data-category={plugin.category}
  data-search={`${plugin.name} ${plugin.description} ${plugin.category} ${plugin.author}`.toLowerCase()}
>
  <div class="flex items-start justify-between gap-3">
    <div
      class={`grid size-11 place-items-center rounded-lg text-xl font-bold ${tint}`}
      aria-hidden="true"
    >
      {plugin.icon}
    </div>
    <span
      class="rounded-full bg-secondary px-2.5 py-1 text-[10px] font-bold tracking-wider text-secondary-foreground uppercase"
      >{plugin.category}</span
    >
  </div>

  <h3 class="mt-5 text-lg font-semibold tracking-tight">{plugin.name}</h3>
  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
    {plugin.description}
  </p>

  <div
    class="mt-auto flex items-center justify-between gap-3 pt-5 text-xs text-muted-foreground"
  >
    <span>v{plugin.version} &middot; {plugin.author}</span>
    <a
      href={plugin.repository}
      target="_blank"
      rel="noreferrer"
      class="font-semibold text-primary transition-opacity hover:opacity-80"
      >View plugin &nearr;</a
    >
  </div>
</article>
