---
import type { Plugin } from "../lib/marketplace";

interface Props {
  plugin: Plugin;
}

const { plugin } = Astro.props;
const slug = plugin.name.toLowerCase().replace(/\s+/g, "-");
---

<a
  href={plugin.repository}
  class="plugin-card group flex flex-col rounded-lg border border-border bg-card p-5 text-card-foreground transition-colors hover:border-foreground/25 hover:bg-accent"
  data-name={plugin.name}
  data-category={plugin.category}
  data-search={`${plugin.name} ${plugin.description} ${plugin.category} ${plugin.author}`.toLowerCase()}
>
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="truncate text-sm font-bold tracking-tight">{slug}</h3>
    {
      plugin.featured && (
        <span class="shrink-0 text-[10px] tracking-wider text-primary uppercase">
          featured
        </span>
      )
    }
  </div>

  <p class="mt-2 line-clamp-3 text-xs leading-relaxed text-muted-foreground">
    {plugin.description}
  </p>

  <div class="mt-auto flex items-center gap-2 pt-4 text-[11px] text-muted-foreground">
    <span class="rounded border border-border px-1.5 py-0.5">{plugin.category}</span>
    <span class="truncate">{plugin.author}</span>
    <span class="ml-auto shrink-0">v{plugin.version}</span>
  </div>
</a>
