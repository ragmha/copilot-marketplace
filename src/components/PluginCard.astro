---
import {
  describeContents,
  describeUpdated,
  installCommand,
  pluginArt,
  pluginHref,
  typeChip,
  type Plugin,
} from "../lib/marketplace";

type Props = { plugin: Plugin };
const { plugin } = Astro.props;
const art = pluginArt(plugin.name);
const contents = describeContents(plugin.contains);
---

<article
  class="plugin-card group relative flex min-w-0 flex-col overflow-hidden rounded-lg border border-border bg-card text-card-foreground transition-shadow hover:shadow-md"
  data-name={plugin.name}
  data-type={plugin.type}
  data-category={plugin.category}
  data-updated={plugin.updated}
  data-search={`${plugin.name} ${plugin.description} ${plugin.category} ${plugin.author} ${plugin.version} ${plugin.components?.map((component) => component.name).join(" ") ?? ""}`.toLowerCase()}
>
  <div class="h-0.5" style={`background:${art.gradient}`} aria-hidden="true"></div>
  <div class="flex flex-1 flex-col p-4">
    <div class="flex items-center gap-3">
      <span class="grid size-11 shrink-0 place-items-center rounded-md text-xs font-bold text-background/90" style={`background:${art.gradient}`} aria-hidden="true">{art.monogram}</span>
      <div class="min-w-0">
        <h3 class="truncate text-sm font-bold tracking-tight">
          <a data-plugin-link href={pluginHref(plugin.name)} class="after:absolute after:inset-0">{plugin.name}</a>
        </h3>
        <p class="mt-1 truncate text-[11px] text-muted-foreground">By {plugin.author}</p>
      </div>
    </div>
    <p class="mt-4 line-clamp-3 text-xs leading-relaxed text-muted-foreground">{plugin.description}</p>
    <div class="mt-auto pt-5">
      <div class="flex flex-wrap items-center justify-between gap-2 rounded border border-border bg-muted/35 px-3 py-2 text-[11px]">
        <span class="font-bold text-primary">{typeChip[plugin.type]}</span>
        <span class="text-muted-foreground">v{plugin.version}</span>
      </div>
      <div class="mt-3 flex min-h-5 flex-wrap gap-x-3 gap-y-1 text-[11px] text-muted-foreground">
        {contents.length > 0 ? contents.map((entry) => <span>{entry}</span>) : <span>See source for contents</span>}
        {plugin.featured && <span class="text-primary">Featured</span>}
      </div>
      <p class="mt-3 text-[11px] text-muted-foreground" title={plugin.updated}>{describeUpdated(plugin.updated)}</p>
    </div>
  </div>
  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border px-4 py-3 text-[11px]">
    <button
      type="button"
      data-install={installCommand(plugin.name)}
      aria-label={`Copy install command for ${plugin.name}`}
      class="relative z-10 inline-flex min-h-8 items-center gap-1.5 rounded text-muted-foreground hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring"
    >
      <svg class="size-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="5" y="5" width="8" height="8" rx="1.5"></rect><path d="M10 3H4a1 1 0 0 0-1 1v6"></path></svg>
      Copy command
    </button>
    <span class="inline-flex items-center gap-2 font-bold text-primary" aria-hidden="true">View details <span>→</span></span>
  </div>
</article>
