---
import ThemeToggle from "./ThemeToggle.astro";
import { marketplaceRepo, marketplaceKey } from "../lib/marketplace";

// Every section the nav points at lives on the homepage, so links resolve
// against it. On the homepage itself these stay in-page jumps.
const home = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<header class="border-b border-border">
  <div class="mx-auto flex h-14 w-full max-w-5xl items-center gap-6 px-6">
    <a href={home} class="text-sm font-bold tracking-tight whitespace-nowrap">
      <span class="text-muted-foreground" aria-hidden="true">~/</span>{marketplaceKey}
    </a>

    <nav
      aria-label="Primary"
      class="ml-auto flex items-center gap-5 text-xs text-muted-foreground"
    >
      <a href={`${home}#catalog`} class="transition-colors hover:text-foreground">Browse</a>
      <a
        href={`${home}#anatomy`}
        class="hidden transition-colors hover:text-foreground sm:inline">What is a plugin?</a
      >
      <a href={`${home}#quickstart`} class="transition-colors hover:text-foreground"
        >Quickstart</a
      >
      <a
        href={`https://github.com/${marketplaceRepo}`}
        class="hidden transition-colors hover:text-foreground sm:inline">GitHub</a
      >
      <ThemeToggle />
    </nav>
  </div>
</header>
