---
import ThemeToggle from "./ThemeToggle.astro";
import { marketplaceRepo } from "../lib/marketplace";
---

<header class="border-b border-border">
  <div class="mx-auto flex h-14 w-full max-w-5xl items-center gap-6 px-6">
    <a href="#top" class="text-sm font-bold tracking-tight whitespace-nowrap">
      <span class="text-muted-foreground" aria-hidden="true">~/</span>copilot-marketplace
    </a>

    <nav
      aria-label="Primary"
      class="ml-auto flex items-center gap-5 text-xs text-muted-foreground"
    >
      <a href="#catalog" class="transition-colors hover:text-foreground">Browse</a>
      <a href="#anatomy" class="hidden transition-colors hover:text-foreground sm:inline"
        >What is a plugin?</a
      >
      <a href="#quickstart" class="transition-colors hover:text-foreground">Quickstart</a>
      <a
        href={`https://github.com/${marketplaceRepo}`}
        class="hidden transition-colors hover:text-foreground sm:inline">GitHub</a
      >
      <ThemeToggle />
    </nav>
  </div>
</header>
