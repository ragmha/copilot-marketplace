---
import MarketplaceSearch from "./MarketplaceSearch.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { branding, brandLogoHref, marketplaceHome, pluginGuideHref, submissionHref } from "../lib/marketplace";
const logo = branding.logo ?? branding.logoDark;
const hasLogoVariants = Boolean(branding.logo && branding.logoDark);
---

<header class="sticky top-0 z-40 border-b border-border bg-card text-card-foreground">
  <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center gap-x-5 gap-y-3 px-5 py-3 sm:px-6">
    <a data-brand-home href={marketplaceHome} class="flex min-w-0 flex-1 items-center gap-3 lg:max-w-sm lg:flex-none">
      {logo ? (
        <span class="flex shrink-0 items-center">
          <img
            data-company-logo="light"
            src={brandLogoHref(logo)}
            alt={`${branding.organization} logo`}
            width="128"
            height="40"
            class:list={["h-10 w-24 object-contain sm:w-32", { "dark:hidden": hasLogoVariants }]}
          />
          {hasLogoVariants && branding.logoDark && (
            <img data-company-logo="dark" src={brandLogoHref(branding.logoDark)} alt={`${branding.organization} logo`} width="128" height="40" class="hidden h-10 w-24 object-contain sm:w-32 dark:block" />
          )}
        </span>
      ) : (
        <span data-brand-fallback class="grid size-10 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary" aria-hidden="true">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
            <path d="M17.5 14v7M14 17.5h7" stroke-linecap="round"></path>
          </svg>
        </span>
      )}
      <span class="min-w-0">
        <span data-brand-title class="block truncate text-sm font-bold tracking-tight">{branding.title}</span>
        <span data-brand-organization class="mt-1 block truncate text-[11px] text-muted-foreground">{branding.organization}</span>
      </span>
    </a>

    <div class="order-last w-full lg:order-none lg:ml-2 lg:min-w-56 lg:flex-1">
      <MarketplaceSearch />
    </div>

    <nav aria-label="Primary" class="ml-auto flex shrink-0 items-center gap-2 sm:gap-3">
      <a href={pluginGuideHref} aria-label="What is a plugin?" class="inline-flex min-h-10 items-center px-2 text-xs text-muted-foreground hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring">
        <span class="hidden xl:inline">What is a plugin?</span><span class="xl:hidden">Learn</span>
      </a>
      <a href={`${marketplaceHome}#quickstart`} class="hidden min-h-10 items-center px-2 text-xs text-muted-foreground hover:text-foreground sm:inline-flex">Quickstart</a>
      <a href={submissionHref} aria-label="Submit a skill" class="inline-flex min-h-10 items-center gap-2 rounded-md bg-primary px-3 text-xs font-bold text-primary-foreground hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring">
        <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke-linecap="round"></path></svg>
        <span class="hidden sm:inline">Submit a skill</span>
        <span class="sm:hidden">Submit</span>
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
