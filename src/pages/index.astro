---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Quickstart from "../components/Quickstart.astro";
import Catalog from "../components/Catalog.astro";
import InstallToast from "../components/InstallToast.astro";
import Footer from "../components/Footer.astro";
import catalog from "../../public/marketplace.json";
import { branding, normalize, type Marketplace } from "../lib/marketplace";

// The catalog is generated from `plugins/*/plugin.json` and lives in `public/`
// so it is both this page's source and the file Copilot clients fetch.
const marketplace = catalog as Marketplace;
const plugins = normalize(marketplace);
const categories = new Set(plugins.map((plugin) => plugin.category)).size;
---

<Layout title={branding.title} description={branding.description}>
  <Header />
  <main>
    <Hero count={plugins.length} categories={categories} />
    <Quickstart />
    <Catalog plugins={plugins} />
  </main>
  <Footer />
  <InstallToast />
</Layout>
