---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PluginCard from "../../components/PluginCard.astro";
import catalog from "../../../public/marketplace.json";
import {
  describeContents,
  describeUpdated,
  installCommand,
  marketplaceRepo,
  normalize,
  typeLabel,
  type Marketplace,
  type Plugin,
} from "../../lib/marketplace";

export function getStaticPaths() {
  const plugins = normalize(catalog as Marketplace);

  return plugins.map((plugin) => ({
    params: { slug: plugin.name },
    props: {
      plugin,
      // Same type first, then most recent, so the tail of the page stays relevant.
      related: plugins
        .filter((entry) => entry.name !== plugin.name)
        .sort((a, b) => {
          const byType = Number(b.type === plugin.type) - Number(a.type === plugin.type);
          return byType !== 0 ? byType : b.updated.localeCompare(a.updated);
        })
        .slice(0, 4),
    },
  }));
}

interface Props {
  plugin: Plugin;
  related: Plugin[];
}

const { plugin, related } = Astro.props;

const contents = describeContents(plugin.contains);
const command = installCommand(plugin.name);
const label = typeLabel(plugin.type);
const home = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;

const facts = [
  { term: "Type", value: plugin.type },
  { term: "Version", value: plugin.version },
  { term: "Category", value: plugin.category },
  {
    term: "Updated",
    value: new Date(plugin.updated).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
      timeZone: "UTC",
    }),
  },
  { term: "Marketplace", value: marketplaceRepo },
];
---

<Layout title={`${plugin.name} · Copilot Marketplace`} description={plugin.description}>
  <Header />

  <main class="mx-auto w-full max-w-5xl px-6 pt-12 pb-20">
    <nav aria-label="Breadcrumb" class="text-xs text-muted-foreground">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href={home} class="transition-colors hover:text-foreground">Marketplace</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href={`${home}#catalog`} class="transition-colors hover:text-foreground">{label}</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-foreground" aria-current="page">{plugin.name}</li>
      </ol>
    </nav>

    <p
      class="mt-8 inline-block rounded border border-border px-2 py-0.5 text-[11px] tracking-wide text-muted-foreground uppercase"
    >
      {plugin.type}
    </p>

    <h1 class="mt-3 text-3xl font-bold tracking-tight break-words sm:text-4xl">{plugin.name}</h1>

    <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground">
      <span class="text-foreground">{plugin.author}</span>
      <span aria-hidden="true">·</span>
      <span title={plugin.updated}>{describeUpdated(plugin.updated)}</span>
      {plugin.featured && <span aria-hidden="true">·</span>}
      {plugin.featured && <span class="text-primary">featured</span>}
    </p>

    <div class="mt-8 grid gap-10 border-t border-border pt-8 lg:grid-cols-[1fr_20rem]">
      <div>
        <p class="text-sm leading-relaxed">{plugin.description}</p>

        {
          contents.length > 0 && (
            <>
              <h2 class="mt-8 text-sm font-bold tracking-tight">What's inside</h2>
              <ul class="mt-3 space-y-2 text-sm text-muted-foreground">
                {contents.map((entry) => (
                  <li class="flex items-center gap-2">
                    <span class="text-primary" aria-hidden="true">
                      ✓
                    </span>
                    {entry}
                  </li>
                ))}
              </ul>
            </>
          )
        }

        <h2 class="mt-8 text-sm font-bold tracking-tight">Where it runs</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          Installing this loads its components into the Copilot CLI, the Copilot app, VS Code,
          and the Copilot cloud agent. See <a
            href={`${home}#anatomy`}
            class="text-foreground underline underline-offset-4">what a plugin is</a
          > for how the pieces fit together, or the <a
            href={`${home}#install`}
            class="text-foreground underline underline-offset-4">installation guide</a
          > for each client.
        </p>
      </div>

      <aside class="lg:sticky lg:top-20 lg:self-start">
        <div class="rounded-lg border border-border bg-card p-5">
          <h2 class="text-[11px] tracking-wide text-muted-foreground uppercase">Install</h2>

          <button
            type="button"
            data-copy-text={command}
            class="group mt-3 flex w-full items-center gap-2 rounded-md border border-border bg-background px-3 py-2.5 text-left transition-colors hover:bg-accent"
          >
            <span class="select-none text-muted-foreground" aria-hidden="true">$</span>
            <code class="min-w-0 flex-1 truncate text-xs">{command}</code>
            <span
              class="shrink-0 text-[11px] text-muted-foreground transition-colors group-hover:text-foreground"
              >copy</span
            >
          </button>

          <div class="mt-2 flex gap-2">
            <a
              href={plugin.repository}
              class="flex-1 rounded-md border border-border px-3 py-2 text-center text-xs transition-colors hover:bg-accent"
            >
              Source
            </a>
            <button
              type="button"
              data-copy-link
              class="flex-1 rounded-md border border-border px-3 py-2 text-center text-xs transition-colors hover:bg-accent"
            >
              Copy link
            </button>
          </div>

          <p
            id="detail-copy-status"
            role="status"
            aria-live="polite"
            class="mt-3 min-h-4 text-[11px] break-words text-primary"
          >
          </p>

          <dl class="mt-5 border-t border-border text-xs">
            {
              facts.map((fact) => (
                <div class="flex items-baseline justify-between gap-3 border-b border-border py-2.5 last:border-b-0">
                  <dt class="text-muted-foreground">{fact.term}</dt>
                  <dd class="truncate text-right">{fact.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="mt-16 border-t border-border pt-8">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="text-xl font-bold tracking-tight">More from the directory</h2>
            <a
              href={`${home}#catalog`}
              class="text-xs text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
            >
              Browse all →
            </a>
          </div>

          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            {related.map((entry) => (
              <PluginCard plugin={entry} />
            ))}
          </div>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>

<script>
  const status = document.getElementById("detail-copy-status");

  const copy = async (text: string, label: string) => {
    if (!status) return;
    try {
      await navigator.clipboard.writeText(text);
      status.textContent = `${label} copied.`;
    } catch {
      status.textContent = `Copy failed. Use this value manually: ${text}`;
    }
  };

  document.querySelector<HTMLElement>("[data-copy-text]")?.addEventListener("click", (event) => {
    const text = (event.currentTarget as HTMLElement).dataset.copyText;
    if (text) void copy(text, "Install command");
  });

  document.querySelector<HTMLElement>("[data-copy-link]")?.addEventListener("click", () => {
    void copy(window.location.href, "Link");
  });
</script>
