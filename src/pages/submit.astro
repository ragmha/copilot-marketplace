---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import catalog from "../../public/marketplace.json";
import { branding, marketplaceHome, marketplaceRepo, pluginTypes } from "../lib/marketplace";

const categories = [...new Set(catalog.plugins.map((plugin) => plugin.category))].sort();
const names = catalog.plugins.map((plugin) => plugin.name);
const configured = !marketplaceRepo.toLowerCase().startsWith("your-org/");
const fieldClass = "mt-2 w-full rounded-md border border-border bg-card px-3 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-ring";
---

<Layout title={`Submit a skill · ${branding.title}`} description={`Propose a reusable capability for ${branding.title}. A maintainer reviews every submission.`}>
  <Header />
  <main class="mx-auto w-full max-w-7xl px-5 pt-10 pb-16 sm:px-6">
    <nav aria-label="Breadcrumb" class="text-xs text-muted-foreground">
      <a href={marketplaceHome} class="hover:text-foreground">Marketplace</a>
      <span class="mx-2" aria-hidden="true">/</span><span aria-current="page">Submit a skill</span>
    </nav>
    <div class="mt-8 grid gap-5 border-b border-border pb-8 lg:grid-cols-2">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Submit a skill</h1>
      <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground">
        Describe what you want to share. We'll prepare a GitHub review request for
        {branding.organization}; you review and submit it using your GitHub account.
        No Git commands or JSON required.
      </p>
    </div>

    {!configured && <p class="mt-6 rounded-md border border-border bg-muted p-4 text-sm">Template preview: configure your real repository with <code>bun run setup</code> before accepting submissions. You can still try the form and copy a draft.</p>}

    <div class="mt-8 grid items-start gap-8 lg:grid-cols-2">
      <form id="submission-form" data-repository={marketplaceRepo} data-configured={String(configured)} data-existing-names={JSON.stringify(names)} novalidate class="space-y-6">
        <div id="import-drop-zone" role="group" aria-labelledby="import-heading" class="rounded-lg border border-dashed border-border bg-card p-5 data-[dragging=true]:border-primary data-[dragging=true]:bg-primary/5">
          <h2 id="import-heading" class="text-sm font-bold">Already have a file?</h2>
          <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
            Drop one SKILL.md or plugin.json here, or choose a file.
            It stays in your browser: nothing is uploaded, installed, or executed.
          </p>
          <input id="submission-file" type="file" accept=".md,.json" hidden />
          <button id="choose-import" type="button" class="mt-3 min-h-10 rounded-md border border-border px-4 text-xs font-bold hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring">Choose a file</button>
          <p class="mt-2 text-[11px] text-muted-foreground">Text files up to 128 KiB. No ZIP or folder import.</p>
          <p id="import-status" role="status" aria-live="polite" class="mt-3 min-h-4 break-words text-xs text-primary"></p>
          <div id="import-review" hidden class="mt-3 border-t border-border pt-4">
            <p id="import-summary" class="text-sm break-words"></p>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">Using these details replaces the current form. Review the fields and confirm sharing again before continuing.</p>
            <div class="mt-3 flex flex-wrap gap-3">
              <button id="apply-import" type="button" class="min-h-10 rounded-md bg-primary px-4 text-xs font-bold text-primary-foreground hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring">Use these details</button>
              <button id="cancel-import" type="button" class="min-h-10 rounded-md border border-border px-4 text-xs hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring">Cancel import</button>
            </div>
          </div>
        </div>
        <div id="submission-errors" hidden role="alert" tabindex="-1" class="rounded-md border border-destructive/40 bg-card p-4">
          <p class="text-sm font-bold">A few details need attention</p>
          <ul id="submission-error-list" class="mt-2 list-disc space-y-1 pl-5 text-sm text-destructive"></ul>
        </div>
        <div>
          <label for="submit-name" class="text-sm font-bold">Skill name <span class="font-normal text-muted-foreground">(required)</span></label>
          <input id="submit-name" name="name" required maxlength="80" placeholder="Deal health check" class={fieldClass} />
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="submit-kind" class="text-sm font-bold">What are you sharing?</label>
            <select id="submit-kind" name="kind" class={fieldClass}>
              {pluginTypes.map((entry) => <option value={entry.type} selected={entry.type === "skill"}>{entry.label}</option>)}
            </select>
          </div>
          <div>
            <label for="submit-slug" class="text-sm font-bold">Suggested identifier</label>
            <input id="submit-slug" name="slug" required maxlength="64" aria-describedby="slug-help" class={fieldClass} />
            <p id="slug-help" class="mt-2 text-xs text-muted-foreground">Generated from the name. You can adjust it if needed.</p>
          </div>
        </div>
        <div>
          <label for="submit-description" class="text-sm font-bold">What does it do, and when should someone use it?</label>
          <textarea id="submit-description" name="description" required maxlength="1024" rows="3" placeholder="Explain the task it helps with in a sentence or two." class={fieldClass}></textarea>
        </div>
        <div>
          <label for="submit-repository" class="text-sm font-bold">Already have a repository? <span class="font-normal text-muted-foreground">(optional)</span></label>
          <input id="submit-repository" name="repository" type="url" maxlength="500" placeholder="https://github.com/your-team/your-skill" aria-describedby="repository-help" class={fieldClass} />
          <p id="repository-help" class="mt-2 text-xs leading-relaxed text-muted-foreground">Link existing content, or write a draft below. New drafts need a source repository before they can be published.</p>
        </div>
        <div>
          <label for="submit-instructions" class="text-sm font-bold">Instructions for Copilot</label>
          <textarea id="submit-instructions" name="instructions" maxlength="20000" rows="9" placeholder="Describe the steps Copilot should follow, what information it needs, and what a useful result looks like." aria-describedby="instructions-help" class={fieldClass}></textarea>
          <p id="instructions-help" class="mt-2 text-xs text-muted-foreground">Plain language is fine. Add instructions or a repository link; you don't need both.</p>
        </div>
        <details class="rounded-lg border border-border bg-card p-4">
          <summary class="cursor-pointer text-sm font-bold">Optional details for the reviewer</summary>
          <div class="mt-5 space-y-5">
            <div><label for="submit-author" class="text-sm">Your name or team</label><input id="submit-author" name="author" maxlength="120" class={fieldClass} /><p class="mt-2 text-xs text-muted-foreground">GitHub credits the account that submits the issue. No email address is required.</p></div>
            <div><label for="submit-category" class="text-sm">Use case</label><input id="submit-category" name="category" list="submission-categories" maxlength="80" placeholder="Choose a suggestion or describe the use case" class={fieldClass} /><datalist id="submission-categories">{categories.map((category) => <option value={category} />)}</datalist></div>
            <div><label for="submit-version" class="text-sm">Version, if already packaged</label><input id="submit-version" name="version" maxlength="40" placeholder="Leave blank if you are not sure" class={fieldClass} /></div>
          </div>
        </details>
        <label class="flex items-start gap-3 text-sm leading-relaxed">
          <input id="submit-acknowledged" name="acknowledged" type="checkbox" required class="mt-1 size-4 shrink-0 accent-primary" />
          <span>I can share this with the destination repository, it contains no secrets or customer data, and I understand a maintainer must review it before publication.</span>
        </label>
        <p class="text-xs leading-relaxed text-muted-foreground">
          Continuing sends these fields to GitHub in a prefilled link, which may appear in browser history.
          Nothing is submitted or published until you finish on GitHub.
        </p>
        <button id="submission-continue" type="submit" disabled class="min-h-11 rounded-md bg-primary px-5 text-sm font-bold text-primary-foreground hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50">Review on GitHub</button>
        <noscript><p class="text-sm text-muted-foreground">JavaScript is needed for the preview. You can instead <a href={`https://github.com/${marketplaceRepo}/issues/new?template=new-plugin.yml`} class="text-primary underline">open the GitHub submission form</a>.</p></noscript>
      </form>

      <aside class="min-w-0 rounded-xl border border-border bg-card p-5 lg:sticky lg:top-24">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-lg font-bold">Draft preview</h2>
          <button type="button" id="copy-submission" class="min-h-10 rounded-md border border-border px-3 text-xs hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring">Copy draft</button>
        </div>
        <p class="mt-2 text-xs leading-relaxed text-muted-foreground">Skill instructions preview as SKILL.md. Existing repositories preview as a review request.</p>
        <pre class="mt-4 max-h-96 overflow-auto rounded-lg border border-border bg-muted/40 p-4 text-xs leading-relaxed whitespace-pre-wrap break-words"><code id="submission-preview">Fill in the form to preview your draft.</code></pre>
        <p id="submission-status" role="status" aria-live="polite" class="mt-3 min-h-4 text-xs text-primary"></p>
        <div id="submission-copy-fallback" hidden class="mt-4 rounded-md border border-border p-4 text-sm">
          <p>Your draft is too long for a reliable prefilled link. Copy the full draft, then paste it into <strong>Instructions or skill draft</strong> on GitHub. The other fields will still be filled in.</p>
          <label class="mt-3 flex items-start gap-2"><input id="draft-copied" type="checkbox" class="mt-1 size-4 shrink-0 accent-primary" /><span>I have copied the full draft.</span></label>
          <a id="submission-fallback-link" aria-disabled="true" class="mt-3 inline-block text-primary underline aria-disabled:opacity-50">Continue to GitHub</a>
        </div>
      </aside>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { skillSlug, submissionLink, submissionPreview, validateSubmission, type Submission, type SubmissionError } from "../lib/submission";
  import { maxImportBytes, parseSubmissionFile, type ImportedSubmission } from "../lib/submission-import";

  const form = document.getElementById("submission-form") as HTMLFormElement | null;
  const name = document.getElementById("submit-name") as HTMLInputElement | null;
  const slug = document.getElementById("submit-slug") as HTMLInputElement | null;
  const kind = document.getElementById("submit-kind") as HTMLSelectElement | null;
  const preview = document.getElementById("submission-preview");
  const errors = document.getElementById("submission-errors");
  const errorList = document.getElementById("submission-error-list");
  const status = document.getElementById("submission-status");
  const submit = document.getElementById("submission-continue") as HTMLButtonElement | null;
  const copy = document.getElementById("copy-submission");
  const fallback = document.getElementById("submission-copy-fallback");
  const copied = document.getElementById("draft-copied") as HTMLInputElement | null;
  const fallbackLink = document.getElementById("submission-fallback-link") as HTMLAnchorElement | null;
  if (!form || !name || !slug || !kind || !preview || !errors || !errorList || !status || !submit || !copy || !fallback || !copied || !fallbackLink) {
    throw new Error("The submission page is missing required controls.");
  }
  const repository = form.dataset.repository;
  if (!form.dataset.existingNames) throw new Error("The submission page is missing its catalog names.");
  const names: unknown = JSON.parse(form.dataset.existingNames);
  if (!repository || !Array.isArray(names) || !names.every((entry): entry is string => typeof entry === "string")) {
    throw new Error("The submission page has invalid catalog configuration.");
  }
  const existingNames: string[] = names;
  const kinds = Array.from(kind.options).map((option) => option.value);
  let slugEdited = false;
  let pendingUrl = "";
  let attempted = false;
  const fileInput = document.getElementById("submission-file") as HTMLInputElement | null;
  const dropZone = document.getElementById("import-drop-zone");
  const importStatus = document.getElementById("import-status");
  const importReview = document.getElementById("import-review");
  const importSummary = document.getElementById("import-summary");
  const chooseImport = document.getElementById("choose-import");
  const applyImport = document.getElementById("apply-import");
  const cancelImport = document.getElementById("cancel-import");
  if (!fileInput || !dropZone || !importStatus || !importReview || !importSummary || !chooseImport || !applyImport || !cancelImport) {
    throw new Error("The submission page is missing its import controls.");
  }
  let pendingImport: ImportedSubmission | null = null;
  let importSequence = 0;
  const values = (): Submission => {
    const data = new FormData(form);
    const text = (key: string) => String(data.get(key) ?? "").trim();
    return {
      name: text("name"), slug: text("slug"), kind: text("kind"),
      description: text("description"), repository: text("repository"), instructions: String(data.get("instructions") ?? ""),
      author: text("author"), category: text("category"), version: text("version"),
      acknowledged: data.has("acknowledged"),
    };
  };
  const syncFallback = () => {
    if (copied.checked && pendingUrl) fallbackLink.href = pendingUrl;
    else fallbackLink.removeAttribute("href");
    fallbackLink.setAttribute("aria-disabled", String(!copied.checked));
  };
  const showErrors = (problems: SubmissionError[]) => {
    errorList.replaceChildren();
    for (const problem of problems) {
      const li = document.createElement("li");
      const link = document.createElement("a");
      link.href = `#submit-${problem.field}`;
      link.textContent = problem.message;
      li.append(link);
      errorList.append(li);
    }
    errors.hidden = problems.length === 0;
  };
  const update = () => {
    const draft = values();
    preview.textContent = draft.name || draft.description || draft.instructions
      ? submissionPreview(draft) : "Fill in the form to preview your draft.";
    pendingUrl = "";
    fallback.hidden = true;
    copied.checked = false;
    syncFallback();
    status.textContent = "";
    if (attempted) showErrors(validateSubmission(draft, kinds, existingNames));
  };
  name.addEventListener("input", () => { if (!slugEdited) slug.value = skillSlug(name.value); });
  slug.addEventListener("input", () => { slugEdited = slug.value.length > 0; });
  form.addEventListener("input", update);
  form.addEventListener("change", update);
  const stageFile = async (files: FileList | null) => {
    const sequence = ++importSequence;
    pendingImport = null;
    importReview.hidden = true;
    if (!files || files.length !== 1) {
      importStatus.textContent = "Choose or drop exactly one SKILL.md or plugin.json file.";
      return;
    }
    const file = files[0];
    if (file.size > maxImportBytes) {
      importStatus.textContent = "Choose a text file no larger than 128 KiB. Your current draft is unchanged.";
      return;
    }
    if (!/\.(md|json)$/i.test(file.name)) {
      importStatus.textContent = "Only SKILL.md and plugin.json text files are supported, not ZIPs or folders.";
      return;
    }
    importStatus.textContent = "Reading the file locally...";
    try {
      const text = await file.text();
      if (sequence !== importSequence) return;
      const imported = parseSubmissionFile(file.name, text, kinds);
      pendingImport = imported;
      importSummary.textContent = `${file.name}: ${imported.name} (${imported.kind})`;
      importReview.hidden = false;
      importStatus.textContent = "File read. Your current draft has not changed.";
    } catch (error) {
      if (sequence !== importSequence) return;
      importStatus.textContent = `${error instanceof Error ? error.message : "The file could not be read."} Your current draft is unchanged.`;
    }
  };
  chooseImport.addEventListener("click", () => fileInput.click());
  fileInput.addEventListener("change", () => { void stageFile(fileInput.files); });
  dropZone.addEventListener("dragover", (event) => {
    event.preventDefault();
    dropZone.dataset.dragging = "true";
  });
  dropZone.addEventListener("dragleave", () => { dropZone.dataset.dragging = "false"; });
  dropZone.addEventListener("drop", (event) => {
    event.preventDefault();
    dropZone.dataset.dragging = "false";
    void stageFile(event.dataTransfer?.files ?? null);
  });
  cancelImport.addEventListener("click", () => {
    importSequence += 1;
    pendingImport = null;
    importReview.hidden = true;
    fileInput.value = "";
    importStatus.textContent = "Import cancelled. Your draft is unchanged.";
  });
  applyImport.addEventListener("click", () => {
    if (!pendingImport) {
      importStatus.textContent = "Choose a valid file before importing.";
      return;
    }
    for (const [key, value] of Object.entries(pendingImport)) {
      const field = form.elements.namedItem(key);
      if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement)) {
        throw new Error(`Missing submission field: ${key}`);
      }
      field.value = value;
    }
    const acknowledged = form.elements.namedItem("acknowledged");
    if (!(acknowledged instanceof HTMLInputElement)) throw new Error("Missing sharing confirmation.");
    acknowledged.checked = false;
    pendingImport = null;
    importReview.hidden = true;
    fileInput.value = "";
    slugEdited = false;
    attempted = false;
    showErrors([]);
    update();
    importStatus.textContent = "Details imported. Review the form and confirm sharing before continuing.";
    name.focus();
  });
  copied.addEventListener("change", syncFallback);
  copy.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(submissionPreview(values()));
      status.textContent = "Draft copied.";
      if (pendingUrl) { copied.checked = true; syncFallback(); }
    } catch {
      status.textContent = "Copy failed. Select and copy the preview text manually.";
    }
  });
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    attempted = true;
    const draft = values();
    const problems = validateSubmission(draft, kinds, existingNames);
    showErrors(problems);
    if (problems.length) { errors.focus(); return; }
    if (form.dataset.configured !== "true") {
      status.textContent = "Configure the template's repository before opening submissions.";
      return;
    }
    let result: ReturnType<typeof submissionLink>;
    try {
      result = submissionLink(repository, draft);
    } catch (error) {
      if (!(error instanceof RangeError)) throw error;
      status.textContent = error.message;
      document.getElementById("submit-description")?.focus();
      return;
    }
    if (result.copyRequired) {
      pendingUrl = result.url;
      fallback.hidden = false;
      copied.checked = false;
      syncFallback();
      status.textContent = "Copy the full draft before continuing to GitHub.";
      copy.focus();
      return;
    }
    window.location.assign(result.url);
  });
  fallbackLink.addEventListener("click", (event) => {
    if (!copied.checked || !pendingUrl) event.preventDefault();
  });
  submit.disabled = form.dataset.configured !== "true";
</script>
